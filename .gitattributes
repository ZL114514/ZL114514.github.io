* text=auto eol=lf

# Windows-only launchers must keep CRLF: cmd.exe mis-parses LF-only batch files
# (it drifts a byte per line, so 'rem' lines get executed as garbage commands).
*.cmd text eol=crlf
*.bat text eol=crlf
*.vbs text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.mov binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
